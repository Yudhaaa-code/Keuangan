{
  "name": "keuangan-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Root workspace for Keuangan Financial Application",
  "scripts": {
    "dev:server": "npm --prefix server run dev",
    "dev:client": "npm --prefix client run dev",
    "dev": "npm --prefix client run dev",
    "prisma:push": "npx --prefix server prisma db push",
    "prisma:generate": "npx --prefix server prisma generate",
    "prisma:studio": "npx --prefix server prisma studio"
  }
}
